# Copie este arquivo para .env e ajuste os valores.
# NUNCA commite o arquivo .env real.

# Identidade e ambiente
APP_NAME=webhook-service
ENVIRONMENT=dev            # dev | staging | prod
DEBUG=false
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# Servidor
HOST=0.0.0.0
PORT=8000

# Segurança dos webhooks
# Segredo usado para validar a assinatura HMAC-SHA256 dos payloads recebidos.
# Se vazio, a validação de assinatura é desativada (apenas para desenvolvimento local).
WEBHOOK_SECRET=troque-este-segredo
