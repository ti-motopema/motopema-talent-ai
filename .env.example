# Copie para .env e ajuste os valores. NUNCA commite o .env real.

# Identidade
APP_NAME=motopema-talent-ai
ENVIRONMENT=dev       # dev | staging | prod
LOG_LEVEL=INFO        # DEBUG | INFO | WARNING | ERROR

# Servidor
HOST=0.0.0.0
PORT=8000

# LLM — chave e modelo (agnóstico de provedor)
# OpenAI: gere em https://platform.openai.com/api-keys
LLM_API_KEY=sk-...sua-chave-aqui

# Modelo de análise: gpt-4o | gpt-4o-mini | gpt-5.4-mini | gpt-5.4 | gpt-5.6
LLM_MODEL=gpt-4o

# Modelo de transcrição de áudio: gpt-4o-transcribe | gpt-4o-mini-transcribe
LLM_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Prompts — caminhos relativos ao diretório do projeto
PROMPT_VIDEO_PATH=app/prompts/02-motopema-avaliacao-video.md
PROMPT_CURRICULO_PATH=app/prompts/01-motopema-avaliacao-curriculo.md
PROMPT_COMPORTAMENTAL_PATH=app/prompts/03-motopema-perfil-comportamental.md
PROMPT_CONSOLIDADO_PATH=app/prompts/04-motopema-avaliacao-consolidada.md
